#include <metal_stdlib>
using namespace metal;

struct VsOut {
    float4 position [[position]];
    float2 uv;
};

vertex VsOut mtld3d_present_vs(uint vid [[vertex_id]]) {
    // Fullscreen triangle: vid=0 (-1,-1), vid=1 (3,-1), vid=2 (-1,3).
    // Mask bit 0 (×4-1): -1 or 3 along x. Mask bit 1 (×2-1): -1 or 3 along y.
    float2 pos = float2(float(vid & 1u) * 4.0 - 1.0,
                        float(vid & 2u) * 2.0 - 1.0);
    VsOut out;
    out.position = float4(pos, 0.0, 1.0);
    // Metal NDC y+ is up; texture v+ is down. Flip y so display-top
    // samples texture-top (game writes top-of-frame at texture row 0).
    out.uv = float2((pos.x + 1.0) * 0.5, (1.0 - pos.y) * 0.5);
    return out;
}

// SDR present: sample and write, no colour transform. The source and the
// drawable are both gamma-encoded 8-bit, so the only work is the resample
// the sampler does. At matching extents every fragment lands on its own
// texel centre and `filter::linear` returns that texel unchanged, so this
// is a bit-exact copy; at differing extents it is a bilinear stretch in
// either direction.
fragment float4 mtld3d_present_ps_copy(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    return src.sample(s, in.uv);
}

// ── Gamma ramp ──
//
// D3D9's gamma ramp maps each 8-bit code to a 16-bit display level. It is the
// display's transfer function, so it applies to the gamma-encoded value the
// sampler just read, before any decode: the HDR stages run it first and
// linearise the result, which is the same order as applying it to the frame a
// monitor would have received.
//
// The table is 256 entries of `ushort4` (R, G, B, one), handed in per pass
// through `setFragmentBytes:`. The source is 8-bit, but the sampler resamples
// it, so a channel lands between two codes: interpolating between the
// neighbouring entries is what keeps a stretched or scaled frame smooth
// instead of banding on the table's steps.
inline float3 apply_gamma_ramp(float3 encoded, constant ushort4* lut) {
    float3 x = clamp(encoded, 0.0f, 1.0f) * 255.0f;
    float3 lo = floor(x);
    float3 frac = x - lo;
    uint3 i0 = uint3(lo);
    uint3 i1 = min(i0 + 1u, uint3(255u));
    float3 a = float3(lut[i0.x].r, lut[i0.y].g, lut[i0.z].b);
    float3 b = float3(lut[i1.x].r, lut[i1.y].g, lut[i1.z].b);
    return mix(a, b, frac) * (1.0f / 65535.0f);
}

fragment float4 mtld3d_present_ps_copy_gamma(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant ushort4* lut [[buffer(1)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(apply_gamma_ramp(sample.rgb, lut), sample.a);
}

// Readback resolve for the single-precision float formats: the same copy with
// a nearest sampler. `R32Float`, `RG32Float` and `RGBA32Float` filter only
// where the device says so (never on the Mac2 family), and a readback has to
// read the same on every GPU, so those formats snap to the nearest texel
// everywhere instead of blending where they can.
fragment float4 mtld3d_readback_ps_copy_nearest(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]]
) {
    constexpr sampler s(coord::normalized, filter::nearest,
                        address::clamp_to_edge);
    return src.sample(s, in.uv);
}

struct HdrUniforms {
    float l_hdr_nits;       // min(max(headroom, 1) * REFERENCE_WHITE_NITS, 10000)
    float p_hdr;            // 1 + 32 * pow(l_hdr_nits/10000, 1/2.4)
    float log2_p_hdr;       // log2(p_hdr)
    float inv_p_minus_one;  // 1 / (p_hdr - 1)
};

// BT.2446-A's SDR reference white in nits: its input 1.0, at its design point.
constant float L_SDR = 100.0;
// P_SDR = 1 + 32 * pow(L_SDR / 10000, 1/2.4) at L_SDR = 100. Folded.
constant float P_SDR = 5.6969577f;
constant float LOG_P_SDR = 1.7399323f; // log(P_SDR)
// BT.2408's HDR reference white in nits: where the HDR picture puts the
// screen's SDR white. Method A's output in nits is divided by it, so 203 nits
// show at EDR 1.0 at every headroom.
constant float REFERENCE_WHITE_NITS = 203.0;
// Widest blend of the smooth maximum in `bt2446_ictcp`, in ln luminance.
// Narrower than the smallest gap of Method A above SDR at L_HDR 1000 for a
// luminance at or above 8-bit grey code 1 (0.134, at code 1), so from L_HDR
// 1000 on such a luminance takes Method A's own value. Only luminances under
// grey code 1 still blend there (the gap falls towards 0.06 as Y goes to 0).
constant float ITM_SMOOTH = 0.12;

// sRGB → linear EOTF (IEC 61966-2-1, piecewise). Shared by every HDR stage,
// frame and cursor alike, so the two can never disagree on the decode.
inline float3 srgb_eotf(float3 encoded) {
    return select(
        pow((encoded + 0.055) / 1.055, float3(2.4)),
        encoded / 12.92,
        encoded <= float3(0.04045)
    );
}

fragment float4 mtld3d_present_ps_hdr_passthrough(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(srgb_eotf(sample.rgb), sample.a);
}

fragment float4 mtld3d_present_ps_hdr_passthrough_gamma(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant ushort4* lut [[buffer(1)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(srgb_eotf(apply_gamma_ramp(sample.rgb, lut)), sample.a);
}

// BT.709 linear-light → LMS (combined BT.709 → BT.2020 → LMS).
// Values from Lilium's `colour_space.fxh`. Stored as column-major
// `float3x3` per Metal's MSL convention — `float3x3(col0, col1, col2)`.
constant float3x3 M_BT709_TO_LMS = float3x3(
    float3(0.2958197875977f, 0.1562652587891f, 0.0351760864258f), // col 0
    float3(0.6230921020508f, 0.7272338867188f, 0.1564789062500f), // col 1
    float3(0.0810847778320f, 0.1164960937500f, 0.8083459472656f)  // col 2
);

// LMS → BT.709 linear-light: the inverse of M_BT709_TO_LMS, computed in
// float64 and rounded to ten decimals, so the round trip is the identity
// within 1e-9 and SDR white comes back as 1.0.
constant float3x3 M_LMS_TO_BT709 = float3x3(
    float3( 6.1740117436f, -1.3246879448f, -0.0122371492f),
    float3(-5.3216416751f,  2.5608829838f, -0.2641562583f),
    float3( 0.1476250327f, -0.2361870399f,  1.2763909094f)
);

// LMS-PQ → ICtCp (BT.2100-2 / Lilium `colour_space/ictcp.fxh`). Each row
// of the spec table becomes a column here. The Ct and Cp coefficients are
// Lilium's, within 1.2e-4 of BT.2100's integers over 4096; the inverse
// below is computed from these values, not from the spec's. An inverse of
// other values (the spec's, or the /8192 form that halves Ct and Cp)
// shifts the colour of every chromatic pixel, even one whose luminance the
// tone map leaves alone.
constant float3x3 M_LMS_PQ_TO_ICTCP = float3x3(
    float3(0.5f,  1.61370003f,  4.37806224f), // col 0  (L' coeffs)
    float3(0.5f, -3.32339620f, -4.24553966f), // col 1  (M' coeffs)
    float3(0.0f,  1.70969617f, -0.13252264f)  // col 2  (S' coeffs)
);

// ICtCp → LMS-PQ: the inverse of M_LMS_PQ_TO_ICTCP, computed in float64
// and rounded to ten decimals, so the round trip is the identity within
// 1e-9.
constant float3x3 M_ICTCP_TO_LMS_PQ = float3x3(
    float3(1.0000000067f, 0.9999999933f, 0.9999999808f),   // col 0  (I coeffs)
    float3(0.0086064749f, -0.0086064749f, 0.5600462947f),  // col 1  (Ct coeffs)
    float3(0.1110335352f, -0.1110335352f, -0.3206319682f)  // col 2  (Cp coeffs)
);

// PQ OETF: linear nits (0..10000) → PQ-encoded [0..1]. ST.2084 inverse
// EOTF expressed in the BT.2100 form.
inline float3 pq_oetf(float3 nits) {
    constexpr float M1 = 2610.0f / 16384.0f;
    constexpr float M2 = 2523.0f / 4096.0f * 128.0f;
    constexpr float C1 = 3424.0f / 4096.0f;
    constexpr float C2 = 2413.0f / 4096.0f * 32.0f;
    constexpr float C3 = 2392.0f / 4096.0f * 32.0f;
    float3 y = pow(max(nits, float3(0.0f)) / 10000.0f, float3(M1));
    return pow((float3(C1) + C2 * y) / (float3(1.0f) + C3 * y), float3(M2));
}

// PQ EOTF: PQ-encoded [0..1] → linear nits (0..10000). ST.2084 forward.
inline float3 pq_eotf(float3 pq) {
    constexpr float M1 = 2610.0f / 16384.0f;
    constexpr float M2 = 2523.0f / 4096.0f * 128.0f;
    constexpr float C1 = 3424.0f / 4096.0f;
    constexpr float C2 = 2413.0f / 4096.0f * 32.0f;
    constexpr float C3 = 2392.0f / 4096.0f * 32.0f;
    float3 e = pow(max(pq, float3(0.0f)), float3(1.0f / M2));
    float3 num = max(e - float3(C1), float3(0.0f));
    float3 den = max(float3(C2) - C3 * e, float3(1e-20f));
    return 10000.0f * pow(num / den, float3(1.0f / M1));
}

// BT.2446 Method A: the luminance of an SDR pixel (1.0 = L_SDR) to HDR nits
// for the peak `u.l_hdr_nits` (`yp_sdr → yp_c → yp_p → yp_hdr → nits`).
inline float bt2446_a_nits(float y_sdr, constant HdrUniforms& u) {
    float yp_sdr = pow(y_sdr, 1.0f / 2.4f);
    float yp_c = log((yp_sdr * (P_SDR - 1.0f)) + 1.0f) / LOG_P_SDR;
    // Three-segment piecewise inversion of the SDR mapping; the
    // branching order covers float-precision edge cases where the
    // segment thresholds straddle.
    float yp_0 = yp_c / 1.0770f;
    float yp_1 = (-2.7811f + sqrt(4.83307641f - 4.604f * yp_c)) / -2.302f;
    float yp_2 = (yp_c - 0.5f) / 0.5f;
    float yp_p = yp_0 <= 0.7399f ? yp_0
               : (yp_2 >= 0.9909f ? yp_2 : yp_1);
    // CPU-hoisted constants: pow(p_hdr, yp_p) → exp2(yp_p * log2_p_hdr);
    // 1/(p_hdr-1) replaces the divide.
    float yp_hdr = (exp2(yp_p * u.log2_p_hdr) - 1.0f) * u.inv_p_minus_one;
    return pow(yp_hdr, 2.4f) * u.l_hdr_nits;
}

// The inverse tone map of one linear BT.709 pixel, its luminance never below
// SDR. Shared by the frame and the cursor sprite, which is what keeps the
// cursor exactly as bright as the UI it hovers over.
//
// The SDR picture shows a pixel of luminance Y at Y * REFERENCE_WHITE_NITS.
// Up to a headroom of about 4, Method A puts part of the range under that
// (at 1.5 every 8-bit grey code up to 199, at 3 the darkest eight), so the
// pixel takes the brighter of the two through a smooth maximum in ln
// luminance: with a = ln(Y * REFERENCE_WHITE_NITS) and b = ln(Method A),
// max(a, b) + k h^2 / 4, h = max(k - |a - b|, 0) / k.
// It is never below either curve, its slope is continuous where they cross
// (a hard maximum creases there, which bands a bright gradient), and it does
// not decrease in Y or in the headroom. Its width k = min(ITM_SMOOTH,
// L_HDR / REFERENCE_WHITE_NITS - 1) is 0 at a headroom of 1, where Method A
// lies at or below SDR for every Y, so the result there is the SDR picture.
//
// The new luminance scales the pixel's I, Ct and Cp by one ratio,
// PQ(Y_out) / PQ(Y * REFERENCE_WHITE_NITS), which keeps the ICtCp hue angle
// and Ct / I, so saturated content (spells, fire, sunset) keeps its chroma
// instead of bleaching toward white; a pixel the tone map leaves at its SDR
// luminance keeps its SDR colour. The rule holds for luminance, not for each
// channel: a single channel of a saturated colour can come out below its SDR
// value. A strong primary can leave the gamut and is clipped at 0. Up to
// L_HDR 10000 every value stays finite.
inline float3 bt2446_ictcp(float3 lin, constant HdrUniforms& u) {
    float y_sdr = max(dot(lin, float3(0.2126f, 0.7152f, 0.0722f)), 1e-20f);
    float y_sdr_nits = y_sdr * REFERENCE_WHITE_NITS;
    float a = log(y_sdr_nits);
    float b = log(max(bt2446_a_nits(y_sdr, u), 1e-30f));
    float k = clamp(u.l_hdr_nits * (1.0f / REFERENCE_WHITE_NITS) - 1.0f, 0.0f, ITM_SMOOTH);
    if (b <= a - k) {
        return lin;
    }
    float h = k > 0.0f ? max(k - abs(a - b), 0.0f) / k : 0.0f;
    float y_out_nits = exp(max(a, b) + k * h * h * 0.25f);
    float ratio = pq_oetf(float3(y_out_nits)).x
                / max(pq_oetf(float3(y_sdr_nits)).x, 1e-9f);

    // PQ takes absolute nits, so the pixel enters ICtCp at
    // REFERENCE_WHITE_NITS a unit and leaves the same way.
    float3 ictcp = M_LMS_PQ_TO_ICTCP * pq_oetf(M_BT709_TO_LMS * (lin * REFERENCE_WHITE_NITS));
    float3 rgb_nits = M_LMS_TO_BT709 * pq_eotf(M_ICTCP_TO_LMS_PQ * (ictcp * ratio));

    // Linear BT.709, 1.0 = the screen's SDR white. The layer's
    // `ExtendedLinear*` tag gamut-converts and encodes for the display.
    return max(rgb_nits, float3(0.0f)) / REFERENCE_WHITE_NITS;
}

fragment float4 mtld3d_present_ps_hdr_bt2446(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant HdrUniforms& u [[buffer(0)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(bt2446_ictcp(srgb_eotf(sample.rgb), u), sample.a);
}

fragment float4 mtld3d_present_ps_hdr_bt2446_gamma(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant HdrUniforms& u [[buffer(0)]],
    constant ushort4* lut [[buffer(1)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    float3 ramped = apply_gamma_ramp(sample.rgb, lut);
    return float4(bt2446_ictcp(srgb_eotf(ramped), u), sample.a);
}

// ── Cursor sprite stages ──
//
// The software cursor's sprite onto the overlay window's own drawable, sized
// to the sprite so every fragment lands on its texel. The sprite carries
// straight alpha (a D3D9 A8R8G8B8 cursor surface); Core Animation composites
// premultiplied, so each stage multiplies colour by alpha after the colour
// transform its frame twin applies. The compositor blends the window, the
// pass itself needs no blend state.

fragment float4 mtld3d_cursor_ps_copy(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(sample.rgb * sample.a, sample.a);
}

fragment float4 mtld3d_cursor_ps_hdr_passthrough(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(srgb_eotf(sample.rgb) * sample.a, sample.a);
}

fragment float4 mtld3d_cursor_ps_hdr_bt2446(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant HdrUniforms& u [[buffer(0)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(bt2446_ictcp(srgb_eotf(sample.rgb), u) * sample.a, sample.a);
}

// The gamma twins of the three stages above. A D3D9 gamma ramp is the
// display's transfer function, so it reaches the cursor as well: ramping the
// frame and leaving the sprite at full brightness is what a player would see
// as a bug. The sprite is its own drawable, so it carries the table itself
// rather than inheriting the frame pass's binding.

fragment float4 mtld3d_cursor_ps_copy_gamma(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant ushort4* lut [[buffer(1)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(apply_gamma_ramp(sample.rgb, lut) * sample.a, sample.a);
}

fragment float4 mtld3d_cursor_ps_hdr_passthrough_gamma(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant ushort4* lut [[buffer(1)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    return float4(srgb_eotf(apply_gamma_ramp(sample.rgb, lut)) * sample.a, sample.a);
}

fragment float4 mtld3d_cursor_ps_hdr_bt2446_gamma(
    VsOut in [[stage_in]],
    texture2d<float> src [[texture(0)]],
    constant HdrUniforms& u [[buffer(0)]],
    constant ushort4* lut [[buffer(1)]]
) {
    constexpr sampler s(coord::normalized, filter::linear,
                        address::clamp_to_edge);
    float4 sample = src.sample(s, in.uv);
    float3 ramped = apply_gamma_ramp(sample.rgb, lut);
    return float4(bt2446_ictcp(srgb_eotf(ramped), u) * sample.a, sample.a);
}
